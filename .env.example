APP_NAME=Capstan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave sessions host-only. Do not use a parent domain here; artifact HTML is
# served from CAPSTAN_ARTIFACT_RENDER_ORIGIN and must never receive the app
# session cookie.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

CAPSTAN_FEATURE_ARTIFACTS=false
CAPSTAN_FEATURE_POSTMASTER=false
# Normally leave the server id blank so Capstan mints and stores one at install.
# Set it only to restore a previous server identity after rebuilding the server.
CAPSTAN_SERVER_ID=
# Required before the postmaster feature can sign or verify message envelopes.
CAPSTAN_POSTMASTER_SIGNING_KEY=
CAPSTAN_ARTIFACT_MAX_CONTENT_BYTES=1048576
# App origin: https://app.capstan.example
# Render origin: https://artifacts.capstan.example
# Keep these on separate hosts. Artifact content routes refuse app-host requests.
# If unset, artifact viewing fails closed with 404; isolation is never skipped.
CAPSTAN_ARTIFACT_RENDER_ORIGIN=https://artifacts.capstan.test
# Optional comma-separated CDN allowlists for artifact HTML CSP. Defaults are
# locked down; rebind these to trusted CDNs only when a fork needs them.
CAPSTAN_ARTIFACT_CSP_SCRIPT_SRC=
CAPSTAN_ARTIFACT_CSP_STYLE_SRC=
CAPSTAN_ARTIFACT_CSP_FONT_SRC=
CAPSTAN_ARTIFACT_CSP_IMG_SRC=

# Built for Cloud (D30). Capstan is a BfC catalog product, but it owns its own
# invitations table and derives admin from OrgRole, so both auth-foundation
# migrations shipped by the package are opted out. See docs/built-for-cloud.md.
BUILT_FOR_CLOUD_PRODUCT=Capstan
BUILT_FOR_CLOUD_INVITATIONS=false
BUILT_FOR_CLOUD_USER_ADMIN_COLUMN=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Email invites require MAIL_MAILER=cloudflare and a MAIL_FROM_ADDRESS on a Cloudflare-verified sending domain.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=

VITE_APP_NAME="${APP_NAME}"
