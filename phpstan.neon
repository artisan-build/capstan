includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    tmpDir: storage/framework/phpstan

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    scanFiles:
        - _ide_helper_models.php

    level: 7
